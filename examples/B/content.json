        "处理方式"
      ],
      "rows": [
        [
          "封面",
          "校徽尺寸与位置",
          "保留原图，靠左嵌入"
        ],
        [
          "正文",
          "字体与段落",
          "应用预设样式"
        ],
        [
          "页脚",
          "文字与页码域",
          "保持空白"
        ]
      ]
    },
    {
